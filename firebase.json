{
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "startsa-ea49e",
          "appId": "1:938448723456:android:ac296d037d3546c81582e5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "startsa-ea49e",
          "configurations": {
            "android": "1:938448723456:android:ac296d037d3546c81582e5"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/invite",
        "destination": "/invite/index.html"
      },
      {
        "source": "/startup/**",
        "destination": "/open/index.html"
      },
      {
        "source": "/investor/**",
        "destination": "/open/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
