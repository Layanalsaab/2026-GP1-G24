rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase console -> Firestore -> Rules -> Publish).
//
// NOT YET TESTED against the emulator: the redesign added fields and the
// requests / interests / bookmarks / publicProfiles collections (docs/08).
// Run the rules unit tests or the emulator before publishing.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- users
    // Account management rules. Only the owner reads their own document;
    // what other people may see of an investor lives in publicProfiles.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Sign-up stores the profile fields collected on Create Account.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role in ['founder', 'investor']
        && request.resource.data.keys().hasOnly(['role', 'fullName', 'email',
                                                 'createdAt', 'phone', 'city',
                                                 'bio', 'sectorsOfInterest',
                                                 'sectorsOther', 'linkedinUrl',
                                                 'gain', 'offer',
                                                 'photoUrl',
                                                 'emailPublic', 'phonePublic'])
        && validProfile(request.resource.data);

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['onboardingCompleted', 'sector', 'stage',
                       'city', 'fullName', 'bio', 'phone',
                       'sectorsOfInterest', 'sectorsOther',
                       'linkedinUrl', 'gain', 'offer',
                       'investorCriteria',
                       'photoUrl', 'emailPublic', 'phonePublic',
                       'preferredSectors', 'preferredStages',
                       'ticketSize', 'ticketSizeOther',
                       'investmentsCount', 'hasLedRound', 'roundsLed',
                       'coInvest', 'roundSizeMin', 'roundSizeMax',
                       'preferredStagesOther', 'preferredCommerceModels',
                       'preferredCommerceModelsOther', 'lookingFor',
                       'yearsInvesting'])
        && validProfile(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == uid;

      // Bookmarks: owner only. The document id is the item key
      // (s-<startupId>, i-<investorId>, p-<programId>).
      match /bookmarks/{itemKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Limits shared with the app (lib/helpers/validators.dart): name 2..50,
    // bio <= 2000 (founders and investors), email <= 100, phone = 9 digits starting with 5, texts
    // <= 1000.
    function validProfile(d) {
      return d.fullName is string
          && d.fullName.size() >= 2 && d.fullName.size() <= 50
          && d.email is string && d.email.size() <= 100
          && (!('bio' in d) || (d.bio is string && d.bio.size() <= 2000))
          && (!('phone' in d)
              || (d.phone is string && d.phone.matches('^5[0-9]{8}$')))
          && (!('city' in d) || d.city is string)
          && (!('sectorsOfInterest' in d)
              || (d.sectorsOfInterest is list && d.sectorsOfInterest.size() <= 25))
          && optionalString(d, 'sectorsOther', 40)
          && (!('linkedinUrl' in d) || d.linkedinUrl is string)
          && optionalString(d, 'gain', 1000)
          && optionalString(d, 'offer', 1000)
          && optionalString(d, 'lookingFor', 1000)
          && optionalString(d, 'photoUrl', 2048)
          && optionalString(d, 'investmentsCount', 10)
          && optionalString(d, 'yearsInvesting', 20)
          && optionalString(d, 'roundsLed', 10)
          && optionalString(d, 'coInvest', 20)
          && optionalString(d, 'ticketSize', 40)
          && optionalString(d, 'ticketSizeOther', 40)
          && optionalString(d, 'preferredStagesOther', 40)
          && optionalString(d, 'preferredCommerceModelsOther', 40)
          && (!('hasLedRound' in d) || d.hasLedRound == null
              || d.hasLedRound is bool)
          && optionalMoney(d, 'roundSizeMin')
          && optionalMoney(d, 'roundSizeMax')
          && optionalList(d, 'preferredSectors', 25)
          && optionalList(d, 'preferredStages', 6)
          && optionalList(d, 'preferredCommerceModels', 11);
    }

    // ------------------------------------------------------- publicProfiles
    // The public face of an investor (name, title, city, sectors, stages,
    // ticket, about, what they bring / hope to gain, linkedin, photo) so
    // founders and guests can browse investors. Never the email or phone.
    // Written by the owner (or a Cloud Function); readable by everyone.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'title', 'city',
                                                 'sectors', 'stages',
                                                 'ticketRange', 'about', 'bio',
                                                 'valueOffered', 'hopeToGain',
                                                 'linkedin', 'photoUrl',
                                                 'createdAt', 'role',
                                                 'sectorsOfInterest',
                                                 'sectorsOther', 'linkedinUrl',
                                                 'emailPublic', 'phonePublic',
                                                 'email', 'phone', 'startups',
                                                 'isSample', 'updatedAt',
                                                 'photoData'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 50
        && optionalString(request.resource.data, 'about', 1000)
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'valueOffered', 1000)
        && optionalString(request.resource.data, 'hopeToGain', 1000)
        // The photo: a small compressed picture saved as base64 text.
        && optionalString(request.resource.data, 'photoData', 150000)
        && request.resource.data.get('role', 'founder') in ['founder', 'investor']
        // The profile is always public. The e-mail and the phone are listed
        // ONLY when the person set that one to Public (each on its own).
        && (!('email' in request.resource.data)
            || request.resource.data.get('emailPublic', false) == true)
        && (!('phone' in request.resource.data)
            || request.resource.data.get('phonePublic', false) == true)
        && optionalString(request.resource.data, 'email', 100)
        && optionalString(request.resource.data, 'phone', 20)
        && optionalList(request.resource.data, 'sectorsOfInterest', 25)
        && optionalList(request.resource.data, 'startups', 30);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------------------ investors
    // Imported dataset investors (and later public investor profiles), with
    // the same field names as an investor's users/{uid} document. Readable by
    // everyone; the import (Admin SDK) bypasses these rules. The email and
    // phone are listed only when the investor made them Public.
    match /investors/{investorId} {
      allow read: if true;

      // An investor publishes (and keeps fresh) their own listing: the public
      // part of their profile (email / phone only when set to Public).
      allow create, update: if request.auth != null
        && request.auth.uid == investorId
        && request.resource.data.role == 'investor'
        && request.resource.data.keys().hasOnly(['role', 'fullName', 'city',
             'bio', 'preferredSectors', 'preferredStages', 'ticketSize',
             'investmentsCount', 'hasLedRound', 'roundsLed', 'coInvest',
             'roundSizeMin', 'roundSizeMax', 'preferredCommerceModels',
             'linkedinUrl', 'offer', 'lookingFor', 'title', 'photoUrl',
             'createdAt', 'yearsInvesting', 'sectorsOther',
             'preferredStagesOther', 'preferredCommerceModelsOther',
             'emailPublic', 'phonePublic', 'email', 'phone'])
        // Email and phone are listed only when the investor made them Public.
        && (!('email' in request.resource.data)
            || request.resource.data.get('emailPublic', false) == true)
        && (!('phone' in request.resource.data)
            || request.resource.data.get('phonePublic', false) == true)
        && optionalString(request.resource.data, 'yearsInvesting', 20)
        && optionalString(request.resource.data, 'sectorsOther', 40)
        && optionalString(request.resource.data, 'preferredStagesOther', 40)
        && optionalString(request.resource.data, 'preferredCommerceModelsOther', 40)
        && optionalString(request.resource.data, 'email', 100)
        && optionalString(request.resource.data, 'phone', 20)
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 50
        && optionalString(request.resource.data, 'bio', 2000)
        && optionalString(request.resource.data, 'offer', 1000)
        && optionalString(request.resource.data, 'lookingFor', 1000);

      allow delete: if request.auth != null && request.auth.uid == investorId;
    }

    // ------------------------------------------------------------- startups
    // - Anyone, signed in or not, can read a startup where isPublic == true.
    // - A private startup can be read only by its owner and its members
    //   (co-founders and team members, listed in `memberIds`).
    // - `founderId` is the OWNER (final control). It can move to a joined
    //   co-founder (Transfer ownership); `foundedBy`, who created the
    //   startup (the "Founder" title), never changes.
    // - The owner deletes a startup only when nobody else is on it; with
    //   co-founders it is transferred, with only members it is closed.
    // - A closed startup (`status` == 'closed') is read only: its owner can
    //   only reopen it (as private) or leave it; members can leave it.
    // - A co-founder can't remove or demote another co-founder (the joined
    //   co-founders are listed in `coFounderIds`).
    // - A member can change ONE thing: remove themself (Leave startup).
    match /startups/{startupId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null
                      && (resource.data.founderId == request.auth.uid
                          || request.auth.uid in resource.data.get('memberIds', [])));

      // A person invited to take the startup over (a pending OWNER
      // invitation for their verified e-mail) reads it first, to update its
      // team list, even when it is private. One document only, no listing.
      allow get: if request.auth != null
                 && request.auth.token.email_verified == true
                 && invitationFor(startupId).role == 'owner'
                 && invitationFor(startupId).status == 'pending';

      allow create: if request.auth != null
                    && request.resource.data.founderId == request.auth.uid
                    // New: created by its owner, active, and no "Founder
                    // (former)" yet.
                    && request.resource.data.get('foundedBy', request.auth.uid) == request.auth.uid
                    && request.resource.data.get('status', 'active') == 'active'
                    && request.resource.data.get('coFounderIds', []) is list
                    && !('formerFounderId' in request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && validStartup(request.resource.data);

      // The owner and a co-founder edit the startup in ONE rule: a rule that
      // fails still uses up part of the 1000 expressions a request may
      // evaluate, and a startup with every field filled in needs nearly all
      // of them. The owner, who created it and the creation time never
      // change. The owner: an active startup may be closed (whoever is on
      // it); on a closed one only its visibility changes (it is never
      // reopened). A co-founder: an active startup only; the joined
      // co-founders stay as they are.
      allow update: if request.auth != null
                    && (resource.data.founderId == request.auth.uid
                        || resource.data.get('memberRoles', {}).get(request.auth.uid, '') == 'coFounder')
                    && request.resource.data.founderId == resource.data.founderId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && keepsFoundedBy()
                    && (resource.data.founderId == request.auth.uid
                        ? (ownerStatusOk()
                           && request.resource.data.get('coFounderIds', []) is list)
                        : (resource.data.get('status', 'active') == 'active'
                           && request.resource.data.get('status', 'active') == 'active'
                           && keepsCoFounders()))
                    && validStartup(request.resource.data);

      // The owner leaves by handing an ACTIVE startup to someone who joined
      // its team (a co-founder or a member): they become the owner, and she
      // leaves the team (her uid is in none of the member lists).
      allow update: if request.auth != null
                    && resource.data.founderId == request.auth.uid
                    && statusOf(resource.data) == 'active'
                    && statusOf(request.resource.data) == 'active'
                    && request.resource.data.founderId != request.auth.uid
                    && resource.data.get('memberRoles', {})
                         .get(request.resource.data.founderId, '') in ['coFounder', 'member']
                    && !(request.resource.data.founderId
                         in request.resource.data.get('memberIds', []))
                    && !(request.auth.uid in request.resource.data.get('memberIds', []))
                    && !(request.auth.uid in request.resource.data.get('memberRoles', {}))
                    && request.resource.data.get('foundedBy', '') == foundedByOf(resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && validStartup(request.resource.data);

      // Taking over: a person with a VERIFIED e-mail and a pending OWNER
      // invitation sent by the current owner becomes the owner of this
      // ACTIVE startup. The previous owner's card leaves the team list and
      // theirs is added; nothing else changes.
      allow update: if request.auth != null
                    && request.auth.token.email_verified == true
                    && statusOf(resource.data) == 'active'
                    && request.resource.data.founderId == request.auth.uid
                    && !(request.auth.uid in resource.data.get('memberIds', []))
                    && invitationFor(startupId).status == 'pending'
                    && invitationFor(startupId).role == 'owner'
                    && invitationFor(startupId).invitedBy == resource.data.founderId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['founderId', 'foundedBy', 'teamMembers',
                                   'ownerChangedAt', 'updatedAt'])
                    && request.resource.data.get('foundedBy', '') == foundedByOf(resource.data)
                    && request.resource.data.get('teamMembers', []).size() <= 20;

      // Accepting an invitation: a person with a VERIFIED email that has a
      // pending invitation to this ACTIVE startup adds ONLY themselves, with
      // the role the invitation gave (invitation id = startupId~email); a
      // co-founder is added to coFounderIds too.
      allow update: if request.auth != null
                    && request.auth.token.email_verified == true
                    && statusOf(resource.data) == 'active'
                    && !(request.auth.uid in resource.data.get('memberIds', []))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['memberIds', 'memberRoles', 'teamMembers',
                                   'coFounderIds', 'updatedAt'])
                    && request.resource.data.memberIds.toSet()
                         == resource.data.get('memberIds', []).toSet()
                              .union([request.auth.uid].toSet())
                    && request.resource.data.memberRoles
                         .diff(resource.data.get('memberRoles', {}))
                         .affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.get('teamMembers', []).size() <= 20
                    && invitationFor(startupId).status == 'pending'
                    && request.resource.data.memberRoles[request.auth.uid]
                         == invitationFor(startupId).role
                    && request.resource.data.get('coFounderIds', []).toSet()
                         == (invitationFor(startupId).role == 'coFounder'
                               ? resource.data.get('coFounderIds', []).toSet()
                                   .union([request.auth.uid].toSet())
                               : resource.data.get('coFounderIds', []).toSet());

      // Leave startup (or a member's account is deleted, closed startups
      // included): a member removes only their own uid from memberIds,
      // memberRoles and coFounderIds, and their card from the team list
      // (teamMembers: the new list only drops entries, nothing is added or
      // edited). Nothing else changes.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.get('memberIds', [])
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['memberIds', 'memberRoles', 'teamMembers',
                                   'coFounderIds'])
                    && onlyDropsTeamCards()
                    && !(request.auth.uid in request.resource.data.memberIds)
                    && request.resource.data.memberIds.toSet()
                         == resource.data.memberIds.toSet()
                              .difference([request.auth.uid].toSet())
                    && request.resource.data.get('coFounderIds', []).toSet()
                         == resource.data.get('coFounderIds', []).toSet()
                              .difference([request.auth.uid].toSet());

      // The owner deletes her account: her closed startup stays with its
      // team, nobody owns it, it turns Private, and her card leaves the team
      // list.
      allow update: if request.auth != null
                    && resource.data.founderId == request.auth.uid
                    && statusOf(resource.data) == 'closed'
                    && request.resource.data.founderId == ''
                    && request.resource.data.isPublic == false
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['founderId', 'isPublic', 'teamMembers',
                                   'foundedBy', 'updatedAt'])
                    && request.resource.data.get('foundedBy', '') == foundedByOf(resource.data)
                    && onlyDropsTeamCards();

      // The owner, when nobody else is on the startup (only when she deletes
      // her account: in the app a startup is closed, never deleted).
      allow delete: if request.auth != null
                    && resource.data.founderId == request.auth.uid
                    && resource.data.get('memberIds', []).size() == 0;

      // ------------------------------------------------ funding rounds      // ------------------------------------------------ funding rounds
      // startups/{startupId}/fundingRounds/{roundId}. Readable by everyone.
      // Written by the founder or a co-founder, always in the
      // same batch as the startup (StartupRepository), so the rules read the
      // startup AS IT WILL BE after the batch (getAfter): an open round must
      // be the startup's Funding ask with the same amount.
      match /fundingRounds/{roundId} {
        function startupNow() {
          return get(/databases/$(database)/documents/startups/$(startupId)).data;
        }
        function startupAfter() {
          return getAfter(/databases/$(database)/documents/startups/$(startupId)).data;
        }
        function canEdit(s) {
          return request.auth != null
              && (s.founderId == request.auth.uid
                  || s.get('memberRoles', {}).get(request.auth.uid, '') == 'coFounder');
        }

        // Readable by everyone: funding history is public information (the
        // dataset rounds come from public sources), and a round only says
        // the type, amounts, dates and investor names.
        allow read: if true;

        allow create: if canEdit(startupAfter())
                      && statusOf(startupAfter()) == 'active'
                      && request.resource.data.isDataset == false
                      && validRound(request.resource.data, startupAfter(), startupId);

        allow update: if canEdit(startupAfter())
                      && request.resource.data.isDataset == resource.data.isDataset
                      && request.resource.data.startupId == resource.data.startupId
                      && validRound(request.resource.data, startupAfter(), startupId);

        // With the startup (only its owner can delete it).
        allow delete: if request.auth != null
                      && startupNow().founderId == request.auth.uid;
      }
    }

    // ----------------------------------------------- startup ownership
    // Who created the startup (older startups: the owner).
    function foundedByOf(d) {
      return d.get('foundedBy', d.founderId);
    }

    function statusOf(d) {
      return d.get('status', 'active');
    }

    // `foundedBy` never changes (an older startup may get it written once,
    // with the right value).
    function keepsFoundedBy() {
      return request.resource.data.get('foundedBy', foundedByOf(resource.data))
          == foundedByOf(resource.data);
    }

    // The owner's status changes: an active startup may be closed (its team
    // keeps it); a closed one stays closed, and only whether it shows in the
    // Hub can change.
    function ownerStatusOk() {
      return statusOf(resource.data) == 'closed'
          ? (statusOf(request.resource.data) == 'closed'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isPublic', 'updatedAt']))
          : statusOf(request.resource.data) in ['active', 'closed'];
    }

    // A co-founder can't remove or demote a joined co-founder. Older
    // startups without coFounderIds get the list written once.
    function keepsCoFounders() {
      let before = resource.data.get('coFounderIds', null);
      return before == null
          || (request.resource.data.get('coFounderIds', []).toSet() == before.toSet()
              && request.resource.data.get('memberIds', []).toSet().hasAll(before)
              && !request.resource.data.get('memberRoles', {})
                    .diff(resource.data.get('memberRoles', {}))
                    .affectedKeys().hasAny(before));
    }

    // The team list only loses entries (nothing is added or edited).
    function onlyDropsTeamCards() {
      return !('teamMembers' in request.resource.data.diff(resource.data).affectedKeys())
          || (resource.data.get('teamMembers', []).toSet()
                .hasAll(request.resource.data.teamMembers)
              && request.resource.data.teamMembers.size()
                   < resource.data.get('teamMembers', []).size());
    }

    // A funding round document (lib/models/funding_round.dart). [s] is the
    // startup after the write, [id] its document id.
    function validRound(d, s, id) {
      return d.keys().hasOnly(['startupId', 'number', 'status', 'stage',
                               'stageOther', 'amount', 'raised', 'startDate',
                               'endDate', 'investors', 'investorIds',
                               'investorCount', 'wantsLeadInvestor',
                               'amountEstimated', 'raisedEstimated',
                               'isDataset', 'createdAt', 'updatedAt'])
          && d.startupId == id
          && d.number is int && d.number >= 1
          && d.stage is string
          && d.stage.matches('^(pre_seed|seed|series_a|series_b|series_c|other)$')
          && d.amount is int && d.amount > 0
          && d.raised is int && d.raised >= 0
          && d.startDate is timestamp
          && d.investors is list && d.investors.size() <= 50
          && d.updatedAt == request.time
          && (!('wantsLeadInvestor' in d) || d.wantsLeadInvestor == null
              || d.wantsLeadInvestor is bool)
          && ((d.status == 'active'
                 && d.get('endDate', null) == null
                 // The open round IS the startup's Funding ask.
                 && 'funding' in s.lookingFor
                 && s.get('fundingRequirement', null) == d.amount)
              || (d.status == 'completed' && d.endDate is timestamp));
    }

    // Mirrors the app's validation (lib/helpers/startup_validators.dart and
    // the enums in lib/models/startup_enums.dart). The "legacy" values are
    // what documents saved before the current lists were adopted still
    // contain, so those startups can be updated without being rewritten first.
    // The four enum fields use ONE regular-expression check each (a long
    // `in [...]` list costs one expression per value, and a request may
    // evaluate at most 1000 expressions: over it, Firestore refuses the
    // write). The ownership fields (coFounderIds, foundedBy, status,
    // closedAt, ownerChangedAt) are checked by the create / update rules, not
    // here, to stay under that limit.
    function validStartup(d) {
      // The required fields (founderId, name, description, sector, stage,
      // businessModel, location, lookingFor, isPublic) are read below, and
      // reading a missing one refuses the write, so no separate hasAll() is
      // needed (it cost a dozen of the 1000 expressions a request may use).
      return d.keys().hasOnly(['founderId', 'name', 'oneLinePitch', 'description',
                             'sector', 'sectorOther', 'otherSectors', 'stage',
                             'stageOther',
                             'businessModel', 'businessModelOther',
                             'location', 'foundedYear', 'websiteUrl',
                             'lookingFor', 'lookingForOther',
                             'fundingRequirement', 'isPublic',
                             'logoUrl', 'logoData', 'createdAt', 'updatedAt',
                             'problem', 'solution', 'targetCustomers',
                             'differentiation', 'marketSizeTam',
                             'marketSizeSam', 'marketSizeSom', 'teamMembers',
                             'expectedGrowth', 'currentAvailableCapital',
                             'expectedRevenueYear1', 'expectedRevenueYear2',
                             'expectedRevenueYear3', 'valuation',
                             'wantsLeadInvestor', 'memberIds', 'memberRoles',
                             // Ownership and closing ('formerFounderId' is
                             // legacy: older test startups still have it)
                             'coFounderIds', 'foundedBy', 'formerFounderId',
                             'status', 'closedAt', 'ownerChangedAt',
                             // Finance and Growth / Startup Ask answers
                             'revenueThisYear', 'monthlyBurnRate',
                             'businessModelExplanation', 'raisedInRound',
                             'partnerTypes', 'supportTypes'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        // The one-line pitch: at most 120.
        && d.description is string && d.description.size() <= 1500
        && d.sector.matches('^(healthtech|fintech|edtech|ecommerce|logistics|agritech|proptech|cleantech|tourism|saas|ai|cybersecurity|gaming|media|foodtech|mobility|retail|energy|insurtech|legaltech|hr_tech|biotech|manufacturing|sports|other|hrtech|ecommerce_retail|logistics_transport|food_beverage|software_cloud)$')
        && d.stage.matches('^(pre_seed|seed|series_a|series_b|series_c|other|idea|mvp|early_revenue|growth)$')
        && d.businessModel.matches('^(b2g|b2b|b2b2c|d2c|b2c|c2c|b2e|c2b|g2c|g2g|other|marketplace)$')
        && d.location.matches('^(abha|al_ahsa|al_baha|al_jubail|al_kharj|al_khobar|al_qatif|arar|buraydah|dammam|dhahran|hafar_al_batin|hail|jazan|jeddah|khamis_mushait|makkah|madinah|najran|riyadh|sakaka|tabuk|taif|unaizah|yanbu|khobar|mecca|medina|other)$')
        // May be empty: a startup whose only ask was Funding has none
        // after its round closes ("Not raising right now").
        && d.lookingFor is list
        && d.lookingFor.hasOnly(['funding', 'cofounder', 'talent',
                                 'partnership', 'support', 'mentorship', 'advisors',
                                 'marketing', 'tech_development', 'other',
                                 // legacy
                                 'partnerships', 'team_members', 'services'])
        // What the founder typed after choosing Other: optional, at most 40
        // characters, and required when the matching value is other.
        && validOther(d, 'sectorOther', d.sector)
        && validOther(d, 'stageOther', d.stage)
        && validOther(d, 'businessModelOther', d.businessModel)
        && optionalString(d, 'lookingForOther', 40)
        // The sectors after the main one (any number, at most all 25).
        && (!('otherSectors' in d) || (d.otherSectors is list && d.otherSectors.size() <= 30))
        && (!('other' in d.lookingFor)
            || ('lookingForOther' in d && d.lookingForOther is string
                && d.lookingForOther.size() >= 1))
        && validFoundedYear(d)
        && optionalString(d, 'websiteUrl', 2048)
        // The logo: a small compressed picture saved as base64 text.
        && optionalString(d, 'logoData', 150000)
        && optionalString(d, 'problem', 1000)
        && optionalString(d, 'solution', 1000)
        && optionalString(d, 'targetCustomers', 1000)
        && optionalString(d, 'differentiation', 1000)
        && optionalMoney(d, 'marketSizeTam')
        && optionalMoney(d, 'marketSizeSam')
        && optionalMoney(d, 'marketSizeSom')
        && optionalMoney(d, 'currentAvailableCapital')
        && optionalMoney(d, 'expectedRevenueYear1')
        && optionalMoney(d, 'expectedRevenueYear2')
        && optionalMoney(d, 'expectedRevenueYear3')
        // The valuation may be 0.
        && optionalMoney(d, 'valuation')
        && optionalMoney(d, 'revenueThisYear')
        && optionalMoney(d, 'monthlyBurnRate')
        && optionalMoney(d, 'raisedInRound')
        && optionalString(d, 'businessModelExplanation', 250)
        && optionalTextList(d, 'partnerTypes')
        && optionalTextList(d, 'supportTypes')
        && (!('teamMembers' in d) || (d.teamMembers is list && d.teamMembers.size() <= 20))
        && (!('wantsLeadInvestor' in d) || d.wantsLeadInvestor == null
            || d.wantsLeadInvestor is bool)
        && validFunding(d)
        && (!('memberIds' in d)
            || (d.memberIds is list && d.memberIds.size() <= 50))
        && (!('memberRoles' in d) || d.memberRoles is map)
        && d.isPublic is bool;
    }

    // Rules stop evaluating after a fixed number of expressions per request,
    // so these helpers use d.get() (one call) instead of several checks.
    function validOther(d, field, value) {
      let v = d.get(field, null);
      return v == null ? value != 'other'
                       : (v is string && v.size() <= 40
                          && (value != 'other' || v.size() >= 1));
    }

    function optionalList(d, field, maxSize) {
      let v = d.get(field, null);
      return v == null || (v is list && v.size() <= maxSize);
    }

    function optionalString(d, field, maxLength) {
      let v = d.get(field, null);
      return v == null || (v is string && v.size() <= maxLength);
    }

    // A list of short texts (partner / support types): at most 10 entries
    // (the app limits each entry to 40 characters).
    function optionalTextList(d, field) {
      let v = d.get(field, null);
      return v == null || (v is list && v.size() <= 10);
    }

    // A SAR amount: a whole number (or null). The app already limits it to 0
    // or more and 13 digits; every extra check here costs about two of the
    // 1000 expressions a request may use, and a startup that fills in all
    // twelve amounts, picks "Other" three times and is edited by a co-founder
    // needs almost all of them (tools/rules_tests/parity.test.mjs proves it
    // still fits).
    function optionalMoney(d, field) {
      let v = d.get(field, null);
      return v == null || v is int;
    }

    // The founded year runs from 1900 to the current year.
    function validFoundedYear(d) {
      return !('foundedYear' in d) || d.foundedYear == null
        || (d.foundedYear is int && d.foundedYear >= 1900
            && d.foundedYear <= 2999);
    }

    // The funding amount: a positive whole number, or null (imported rows
    // that are not looking for funding).
    function validFunding(d) {
      return !('fundingRequirement' in d) || d.fundingRequirement == null
        || (d.fundingRequirement is int && d.fundingRequirement > 0);
    }

    // ------------------------------------------------------------- requests
    // An investor's request to a startup. Created by the investor, read by
    // that investor and by the startup's founder, and only the founder can
    // change the status.
    // ---------------------------------------------------------- invitations
    // One invitation per startup and e-mail; the id is `startupId~email`
    // (e-mail lower-case). A founder or co-founder of the startup creates and
    // cancels them. Anyone can read ONE by its id (the invite screen before
    // the person has an account; the ids can't be guessed) but nobody can
    // list them, except the invited person (verified e-mail) and the person
    // who sent them.
    function invitationFor(startupId) {
      return get(/databases/$(database)/documents/invitations/$(startupId + '~' + request.auth.token.email.lower())).data;
    }

    // The owner or a co-founder of an ACTIVE startup (nobody joins a closed
    // one; its invitations are cancelled before it closes).
    function canInvite(startupId) {
      let s = get(/databases/$(database)/documents/startups/$(startupId)).data;
      return (s.founderId == request.auth.uid
              || s.get('memberRoles', {}).get(request.auth.uid, '') == 'coFounder')
          && s.get('status', 'active') == 'active';
    }

    // The owner of the startup (only she invites someone to take it over).
    function ownsStartup(startupId) {
      return get(/databases/$(database)/documents/startups/$(startupId)).data.founderId
          == request.auth.uid;
    }

    function myVerifiedEmail(d) {
      return request.auth.token.email_verified == true
          && d.emailLower == request.auth.token.email.lower();
    }

    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if request.auth != null
                  && (myVerifiedEmail(resource.data)
                      || resource.data.invitedBy == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['startupId', 'startupName',
             'emailLower', 'role', 'roleText', 'contribution', 'invitedBy',
             'invitedByName', 'status', 'emailSent', 'createdAt', 'lastSentAt',
             'respondedAt', 'newUser'])
        && request.resource.data.get('newUser', false) is bool
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && invitationId == request.resource.data.startupId + '~'
                           + request.resource.data.emailLower
        && (request.resource.data.role in ['coFounder', 'member']
            || (request.resource.data.role == 'owner'
                && ownsStartup(request.resource.data.startupId)))
        && request.resource.data.emailLower.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && request.resource.data.emailLower.size() <= 100
        && optionalString(request.resource.data, 'roleText', 40)
        && optionalString(request.resource.data, 'contribution', 300)
        && optionalString(request.resource.data, 'startupName', 40)
        && optionalString(request.resource.data, 'invitedByName', 50)
        && canInvite(request.resource.data.startupId);

      allow update: if request.auth != null
        && (
          // The team: cancel, re-invite, mark the e-mail as sent. Only the
          // owner makes it an invitation to take the startup over.
          (canInvite(resource.data.startupId)
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'emailSent', 'lastSentAt', 'role',
                          'roleText', 'contribution', 'newUser'])
           && request.resource.data.status in ['pending', 'cancelled']
           && (request.resource.data.role != 'owner'
               || ownsStartup(resource.data.startupId)))
          ||
          // The invited person: accept or decline.
          (myVerifiedEmail(resource.data)
           && resource.data.status == 'pending'
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'respondedAt', 'acceptedBy',
                          'acceptedByName'])
           && request.resource.data.get('acceptedByName', '') is string
           && request.resource.data.get('acceptedByName', '').size() <= 50
           && request.resource.data.get('acceptedBy', request.auth.uid)
                == request.auth.uid
           && request.resource.data.status in ['accepted', 'declined'])
        );

      allow delete: if request.auth != null && canInvite(resource.data.startupId);
    }

    // The names of the startups that invited an e-mail that has no account
    // yet, so sign-up can warn "you've been invited" before the account is
    // created. Read one by its id (no listing).
    match /inviteEmails/{emailLower} {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['names', 'updatedAt'])
        && request.resource.data.names is list
        && request.resource.data.names.size() <= 20;
      allow delete: if request.auth != null;
    }

    // Finds an account by e-mail: id = the e-mail (lower-case), written by
    // the account's owner once the e-mail is verified. A signed-in user can
    // read one by its id; nobody can list them.
    match /emailIndex/{emailLower} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == emailLower
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'role',
                                                 'updatedAt'])
        && request.resource.data.role in ['founder', 'investor']
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 50;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.investorId == request.auth.uid
            || resource.data.founderId == request.auth.uid);

      // A request with a `ticketId` is sent from the Investment Wallet: it has
      // no equity, the ticket must be the investor's own OPEN ticket, and the
      // amount must be inside the ticket's range and no more than the open
      // round of the startup still needs (funding minus raised).
      allow create: if request.auth != null
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['startupId', 'founderId',
                                                 'investorId', 'message',
                                                 'amount', 'equity', 'status',
                                                 'createdAt', 'ticketId',
                                                 'startupName'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && (('ticketId' in request.resource.data)
            ? validTicketRequest(request.resource.data)
            : (request.resource.data.equity is number
               && request.resource.data.equity > 0
               && request.resource.data.equity < 100));

      // The owner answers a request; when she hands the startup over, its
      // requests move to the new owner.
      allow update: if request.auth != null
        && resource.data.founderId == request.auth.uid
        && ((request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
             && request.resource.data.status in ['pending', 'accepted', 'declined'])
            || (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['founderId'])
                && request.resource.data.founderId
                     == get(/databases/$(database)/documents/startups/$(resource.data.startupId)).data.founderId));

      // The investor may withdraw their own request; the owner of the
      // startup removes the requests it received when it is deleted.
      allow delete: if request.auth != null
        && (resource.data.investorId == request.auth.uid
            || get(/databases/$(database)/documents/startups/$(resource.data.startupId))
                 .data.founderId == request.auth.uid);
    }

    function validTicketRequest(d) {
      let t = get(/databases/$(database)/documents/tickets/$(d.ticketId)).data;
      let s = get(/databases/$(database)/documents/startups/$(d.startupId)).data;
      let raised = s.get('raisedInRound', 0);
      return t.investorId == request.auth.uid
        && t.status == 'open'
        && d.amount >= t.amountMin
        && d.amount <= t.amountMax
        && d.get('equity', null) == null
        && d.startupName is string && d.startupName.size() <= 60
        && d.founderId == s.founderId
        && s.get('fundingRequirement', 0) > 0
        && d.amount <= s.fundingRequirement - (raised == null ? 0 : raised);
    }

    // ------------------------------------------------------------ interests
    // A startup seeker's "Express interest". Guests have no account, so the
    // app signs them in anonymously (or goes through a Cloud Function).
    // Only the startup's founder reads them and marks them seen.
    match /interests/{interestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['startupId', 'name',
                                                 'roleLine', 'message',
                                                 'createdAt', 'seenByFounder'])
        && request.resource.data.seenByFounder == false
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;

      allow read: if request.auth != null
        && get(/databases/$(database)/documents/startups/$(resource.data.startupId))
             .data.founderId == request.auth.uid;

      allow update: if request.auth != null
        && get(/databases/$(database)/documents/startups/$(resource.data.startupId))
             .data.founderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seenByFounder']);
    }

    // -------------------------------------------------------------- tickets
    // An investor's investment tickets (tickets/{investorId}-T1, ...). Any
    // signed-in user can read them, so matching can use them. The admin
    // scripts (tools/investor_tickets) write the sample ones; an investor
    // creates, edits, closes and deletes their own in the Investment Wallet.
    // A ticket becomes "used" (with its startupId) when a founder accepts a
    // request sent with it: that is NOT allowed here yet (see the report).
    function validTicket(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.sectors is list && d.sectors.size() > 0 && d.sectors.size() <= 25
        && d.stages is list && d.stages.size() > 0 && d.stages.size() <= 6
        && d.amountMin is int && d.amountMax is int
        && d.amountMin >= 1000 && d.amountMax > d.amountMin
        // Not tied to what the investor usually invests; only a sanity limit.
        && d.amountMax <= 10000000000000;
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null;

      // The id is `uid-T{n}`; a new ticket is open and not used yet.
      allow create: if request.auth != null
        && ticketId.matches('^' + request.auth.uid + '-T[0-9]+$')
        && request.resource.data.keys().hasOnly(['investorId', 'name',
             'sectors', 'stages', 'amountMin', 'amountMax', 'status',
             'startupId', 'createdAt'])
        && request.resource.data.investorId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.get('startupId', null) == null
        && request.resource.data.createdAt == request.time
        && validTicket(request.resource.data);

      // The investor edits an OPEN ticket (name, sectors, stages, amounts)
      // or closes it. A closed or used ticket can't change.
      allow update: if request.auth != null
        && resource.data.investorId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.investorId == resource.data.investorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('startupId', null) == null
        && request.resource.data.status in ['open', 'closed']
        && validTicket(request.resource.data);

      // Deleting an account removes its tickets.
      allow delete: if request.auth != null
        && resource.data.investorId == request.auth.uid;
    }
  }
}
